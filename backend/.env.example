SUPABASE_HOST=db.<your-project-ref>.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=<your-database-password>
JWT_SECRET=<your-super-long-password>
JWT_EXPIRES_IN=604800

# ── Google OAuth (Continue with Google) ─────────────────────────
# OAuth 2.0 Client (type "Web application") from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Must add the callback URL below to the client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Public URL of this backend (used to build the callback URL if
# GOOGLE_CALLBACK_URL is not set).
SHIPI_PUBLIC_URL=http://localhost:3001
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Comma-separated list of client redirect URIs allowed after sign-in.
# - Mobile app (native): shipi://auth  (the app's custom scheme)
# - Mobile app (web):    <your-web-origin>/auth
APP_REDIRECT_URIS=shipi://auth,http://localhost:8081/auth

# Allow the Electron desktop app's loopback callback (http://127.0.0.1:PORT
# or http://localhost:PORT) to be used as a redirect target. Keep OFF in
# production.
GOOGLE_ALLOW_LOOPBACK=true